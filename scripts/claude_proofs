#Claude writes a proof, Lean checks it: the core idea of the project in one script

import re
import time

import anthropic
from dotenv import load_dotenv
from lean_interact import check_lean

#define model to use
MODEL = "claude-sonnet-5-5"

#define theorem to be proven
THEOREM = """theorem two_mul_le_sq_add_sq (a b : ℝ) : 2 * a * b ≤ a ^ 2 + b ^ 2 := by sorry"""

#define inpupt prompt for the model
PROMPT = f"""Complete the following Lean 4 theorem. Mathlib is already imported.
Replace `sorry` with a proof. Do not change the theorem statement.
Reply with the complete theorem in a single ```lean code block.

{THEOREM}
"""

def extract_lean_code(text: str) -> str:
    """Return the content of the first ```lean code block, or the whole text if there is none."""
    match = re.search(r"```(?:lean4?)?[ \t]*\n(.*?)```", text, re.DOTALL)
    return match.group(1).strip() if match else text.strip()

def main() -> None:
    load_dotenv()
    client = anthropic.Anthropic()

    # 1) Ask Claude for a proof
    print("Asking Claude ...")
    response = client.messages.create(
        model=MODEL,
        max_tokens=1000, #~700 Wörter
        messages=[{"role": "user", "content": PROMPT}],
    )
    answer = "".join(block.text for block in response.content if block.type == "text")
    proof = extract_lean_code(answer)
    print(proof)
    print(f"(tokens: {response.usage.input_tokens} in / {response.usage.output_tokens} out)")

    # 2) Let Lean check it
    print("\nChecking with Lean ...")
    start = time.perf_counter()
    result = check_lean(proof)
    elapsed = time.perf_counter() - start

    # 3) Judge the result: exit code alone is NOT enough (see `sorry`)
    messages = result.stdout.strip()
    if result.returncode != 0:
        verdict = "REJECTED: Lean reports errors"
    elif "sorry" in messages:
        verdict = "INCOMPLETE: proof uses sorry"
    else:
        verdict = "ACCEPTED: Lean verified the proof"

    print(f"{verdict} ({elapsed:.1f} s)")
    if messages:
        print(messages)


if __name__ == "__main__":
    main()